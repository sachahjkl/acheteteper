        <section class="space-y-3 border border-zinc-200 p-4">
            <h2 class="text-xl font-semibold">WebSocket</h2>
            <p class="text-sm text-zinc-600">Le serveur renvoie chaque message avec un horodatage.</p>
            <div class="flex gap-2">
                <input id="ws-message" value="Bonjour WebSocket" class="min-w-0 flex-1 border border-zinc-300 px-3 py-2">
                <button id="ws-send" class="border border-blue-700 bg-blue-600 px-3 py-2 text-white">Envoyer</button>
            </div>
            <pre id="ws-log" class="min-h-32 overflow-auto bg-zinc-950 p-3 text-sky-300"></pre>
        </section>
    </div>
</div>

<script>
document.querySelector('#sse-start').addEventListener('click', () => {
    const log = document.querySelector('#sse-log');
    log.textContent = '';
    const events = new EventSource('/realtime/events');
    events.addEventListener('tick', event => {
        log.textContent += event.data + '\n';
        if (event.lastEventId === '5') events.close();
    });
});

const wsLog = document.querySelector('#ws-log');
const socket = new WebSocket(`${location.protocol === 'https:' ? 'wss' : 'ws'}://${location.host}/realtime/socket`);
socket.addEventListener('open', () => wsLog.textContent += 'connecté\n');
socket.addEventListener('message', event => wsLog.textContent += event.data + '\n');
socket.addEventListener('close', () => wsLog.textContent += 'déconnecté\n');
document.querySelector('#ws-send').addEventListener('click', () => {
    if (socket.readyState === WebSocket.OPEN) socket.send(document.querySelector('#ws-message').value);
});
</script>
