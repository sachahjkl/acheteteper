<script>
document.querySelectorAll('[data-method]').forEach(button => {
    button.addEventListener('click', async () => {
        const response = await fetch('/request', { method: button.dataset.method });
        document.querySelector('#method-result').textContent = [
            `${button.dataset.method} ${response.status}`,
            `Allow: ${response.headers.get('Allow') ?? '(none)'}`,
        ].join('\n');
    });
});

document.querySelector('#json-form').addEventListener('submit', async event => {
    event.preventDefault();
    const response = await fetch('/request/jsonInput', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': <?= json_encode(Csrf::token(), JSON_THROW_ON_ERROR) ?>,
        },
        body: document.querySelector('#json-body').value,
    });
    const body = await response.text();
    document.querySelector('#json-result').textContent = `${response.status}\n${body}`;
});
</script>

