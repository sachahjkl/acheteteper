<h2>CSRF Token</h2>
<p>Current CSRF Token: <span class="token"><?= isset($token) ? \Httpeur\e($token) : 'None' ?></span></p>

<?php if (isset($success) && $success): ?>
    <div class="success">
        <strong>Success!</strong> <?= \Httpeur\e($message) ?>
