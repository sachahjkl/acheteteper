<?php endif; ?>

<?php if (isset($error) && $error): ?>
    <div class="error">
        <strong>Error!</strong> <?= \Httpeur\e($message) ?>
    </div>
<?php endif; ?>

<h2>Form with CSRF Protection</h2>
<form method="POST" action="/csrf/submit">
    <?= \Httpeur\csrf_field() ?>
    <input type="text" name="data" placeholder="Enter some data" value="Test data">
    <button type="submit">Submit (with CSRF token)</button>
</form>

<h2>Form without CSRF Protection</h2>
<p>This form will fail validation:</p>
<form method="POST" action="/csrf/submit">
    <input type="text" name="data" placeholder="Enter some data" value="Test data">
    <button type="submit">Submit (without CSRF token)</button>
</form>

