<?php

use Acheteteper\Utils\ViewUtils as v;
use Components as c;

$title = 'Session Demo';
$tableClass = 'min-w-full text-sm text-left text-zinc-800 font-mono';
$cellClass = 'px-4 py-3 border-b border-zinc-200';
?>

<section class="space-y-2 mb-6">
    <h2 class="text-xl font-semibold text-zinc-900">Session Counter</h2>
    <p class="text-sm text-zinc-700">This page has been visited <span class="text-2xl font-semibold text-blue-700"><?= $counter ?></span> times.</p>
</section>

<section class="space-y-3 mb-6">
    <h2 class="text-xl font-semibold text-zinc-900">Set Session Value</h2>
    <form method="POST" class="space-y-3 rounded-sm border border-zinc-200 bg-zinc-50 p-4 shadow-sm">
        <?= v::csrfField() ?>
        <div class="grid gap-3 md:grid-cols-2">
            <?= c::FormInput('key', 'Key', '', ['placeholder' => 'Key', 'required' => 'required']) ?>
            <?= c::FormInput('value', 'Value', '', ['placeholder' => 'Value', 'required' => 'required']) ?>
        </div>
        <?= c::Button('Set Session Value', 'blue', ['type' => 'submit']) ?>
    </form>
</section>

<section class="space-y-3">
    <h2 class="text-xl font-semibold text-zinc-900">All Session Data</h2>
    <?php if (empty($allSession)): ?>
        <p class="text-sm text-zinc-700">No session data stored.</p>
    <?php else: ?>
        <div class="scroll-container rounded-sm border border-zinc-200 shadow-sm">
            <table class="<?= $tableClass ?>">
                <thead class="bg-zinc-100 text-xs font-semibold uppercase tracking-wide text-zinc-700">
                    <tr>
                        <th class="px-4 py-3">Key</th>
                        <th class="px-4 py-3">Value</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-zinc-200">
                    <?php foreach ($allSession as $key => $value): ?>
                        <tr>
                            <td class="<?= $cellClass ?>"><?= v::e($key) ?></td>
                            <td class="<?= $cellClass ?>"><?= v::e(is_array($value) ? json_encode($value) : (string)$value) ?></td>
                        </tr>
                    <?php endforeach; ?>
                </tbody>
            </table>
        </div>
    <?php endif; ?>
</section>

<form method="POST" action="/session/clear" class="mt-4">
    <?= v::csrfField() ?>
    <?= c::Button('Clear All Session Data', 'red', ['type' => 'submit']) ?>
</form>
