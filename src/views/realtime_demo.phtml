            <button id="sse-start" class="border border-emerald-700 bg-emerald-600 px-3 py-2 text-white">Démarrer SSE</button>
            <pre id="sse-log" class="min-h-32 overflow-auto bg-zinc-950 p-3 text-emerald-300"></pre>
