<?php
$title = 'Flash Messages Demo';
$successMsg = \Httpeur\flash('success');
$errorMsg = \Httpeur\flash('error');
$infoMsg = \Httpeur\flash('info');
$warningMsg = \Httpeur\flash('warning');
ob_start();
?>

<?php if ($successMsg): ?>
    <div class="flash flash-success"><?= \Httpeur\e($successMsg) ?></div>
<?php endif; ?>

<?php if ($errorMsg): ?>
    <div class="flash flash-error"><?= \Httpeur\e($errorMsg) ?></div>
<?php endif; ?>

<?php if ($infoMsg): ?>
    <div class="flash flash-info"><?= \Httpeur\e($infoMsg) ?></div>
<?php endif; ?>

<?php if ($warningMsg): ?>
    <div class="flash flash-warning"><?= \Httpeur\e($warningMsg) ?></div>
<?php endif; ?>

<h2>Send Flash Message</h2>
<p>Flash messages are displayed once and then removed. Submit the form to see a flash message after redirect.</p>
<form method="POST" action="/flash/submit">
    <select name="type" required>
        <option value="success">Success</option>
        <option value="error">Error</option>
        <option value="info">Info</option>
        <option value="warning">Warning</option>
    </select>
    <input type="text" name="message" placeholder="Message" value="This is a flash message!" required>
    <button type="submit">Send Flash Message</button>
</form>

<?php
